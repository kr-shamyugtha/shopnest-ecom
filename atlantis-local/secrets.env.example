# Copy to ~/.config/atlantis/secrets.env (install.sh does this) and fill in.
# Keep it chmod 600 and out of git.

# Azure DevOps PAT Atlantis uses to clone the repo and comment on PRs.
ATLANTIS_AZUREDEVOPS_TOKEN=

# Basic Auth password on the three Azure DevOps Service Hook subscriptions
# (username `atlantis`). Must match exactly what's entered there.
ATLANTIS_AZUREDEVOPS_WEBHOOK_PASSWORD=

# Password for the Atlantis web UI (username `admin`). Any random value.
ATLANTIS_WEB_PASSWORD=
