[Unit]
Description=Atlantis (Terraform/Terragrunt PR automation for shopnest-ado)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/atlantis/secrets.env
# terragrunt, terraform, az and kubelogin are all shelled out to by plans;
# az provides the Azure credential (the azurerm provider falls back to the
# CLI login when no ARM_* variables are set).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/atlantis server --config=%h/.config/atlantis/config.yaml --repo-config=%h/.config/atlantis/repos.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
